{
  "version": "2.2.0",
  "scripts": {
    "serve": "URL_PREFIX=http://localhost:8090 webpack-dev-server --config-node-env=development --port 8090 --hot",
    "build": "webpack --config-node-env=production",
    "lint": "biome check --error-on-warnings .",
    "lint:ci": "biome ci --error-on-warnings .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "postinstall": "simple-git-hooks"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-or-later",
  "description": "",
  "simple-git-hooks": {
    "pre-commit": "npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "autoprefixer": "^10.4.19",
    "copy-webpack-plugin": "^14.0.0",
    "cssnano": "^8.0.8",
    "html-webpack-plugin": "^5.6.0",
    "postcss-import": "^17.0.0",
    "postcss-loader": "^8.1.1",
    "postcss-nesting": "^14.0.1",
    "simple-git-hooks": "^2.13.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "webpack": "^5.91.0",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "@davidsev/owlbear-ui": "^0.3.0",
    "@davidsev/owlbear-utils": "^2.2.0",
    "@owlbear-rodeo/sdk": "^3.1.0",
    "lit": "^3.1.3",
    "vanilla-colorful": "^0.7.2"
  }
}
